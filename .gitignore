*.db
*.sqlite
*.sqlite3
*.duckdb
*.duckdb.wal

# Exception : autoriser d'éventuels petits fichiers d'exemple synthétiques pour les tests
!tests/fixtures/**

# ==============================================================================
# 6. SECRETS, IDENTIFIANTS SIMNOW / COURTIERS & COOKIES DE SCRAPING
# ==============================================================================
.env
.env.*
!.env.example

# Identifiants CTP / SimNow (BrokerID, UserID, AppID, AuthCode)
*credentials*.toml
*credentials*.json
*secret*.toml
simnow_config.toml
ctp_config.toml

# Cookies et jetons d'authentification des scrapers sociaux (Xueqiu, EastMoney)
cookies.json
cookies.txt
*.session
*.pem
*.key

