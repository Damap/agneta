# ==============================================================================
# 1. RUST, CARGO & PROFILAGE BAS NIVEAU
# ==============================================================================
/target/
**/*.rs.bk
*.pdb

# Note académique : On conserve Cargo.lock dans Git pour garantir la
# reproductibilité bit-à-bit des benchmarks et des résultats de thèse.
# Décommenter uniquement si publié comme pure bibliothèque :
# Cargo.lock

# Rapports Criterion, Flamegraphs et profilage matériel Linux (perf)
perf.data
perf.data.old
flamegraph.svg
flamegraph-*.svg
callgrind.out.*
cachegrind.out.*
dhat-heap.json

# ==============================================================================
# 2. API CTP (SFIT) & ARTÉFACTS FFI C/C++
# ==============================================================================
# L'API C++ CTP génère automatiquement des fichiers binaires de session (.con)
# et des logs lors de la connexion à SimNow ou aux courtiers chinois.
*.con
**/flow/
**/ctp_flow/
ThostFtdc*.log
ctp_*.log

# Objets compilés C/C++ intermédiaires
*.o
*.obj
*.a
*.lib
*.exp

# Ignorer les binaires partagés générés, SAUF les bibliothèques officielles CTP
# placées volontairement dans crates/agneta-ctp-sys/lib/
*.so
*.dylib
*.dll
!crates/agneta-ctp-sys/lib/*.so
!crates/agneta-ctp-sys/lib/*.dll
!crates/agneta-ctp-sys/lib/*.dylib

# ==============================================================================
# 3. PYTHON, MATURIN (PyO3) & ENVIRONNEMENTS VIRTUELS
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so.dSYM/

# Environnements virtuels et gestionnaires (uv, venv, conda)
.venv/
venv/
ENV/
env/
.uv/
.python-version

# Artefacts de build Maturin / Setuptools / Wheel
/build/
/dist/
/wheels/
*.egg-info/
.eggs/
*.egg
*.manifest
*.spec

# Caches de tests, de typage et de linters Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.coverage
htmlcov/

# Jupyter Notebooks (Laboratoire de recherche)
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ==============================================================================
# 4. MODÈLES IA, NLP (FinBERT / LLMs) & EXPÉRIMENTATIONS QUANTUM
# ==============================================================================
