*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
*.tflite
*.gguf

# Caches HuggingFace, WandB, TensorBoard et Optuna
.cache/
huggingface_cache/
wandb/
runs/
lightning_logs/
mlruns/
optuna.db

# ==============================================================================
# 5. DONNÉES DE MARCHÉ (CSMAR / WIND L2-L3) & SCRAPING RÉSEAUX SOCIAUX
# ==============================================================================
# CRITIQUE : Les données Level-2 / Level-3 (逐笔) CSMAR et Wind sont sous licence
# stricte et volumineuses. Ne jamais les pousser sur un dépôt Git public.
/data/
/datasets/
/dumps/
/raw_data/
/market_data/
/social_logs/

